# Meilisearch Configuration Template
# Copy to .env.meilisearch and customize for your environment

# Meilisearch Master Key (required for authenticated access)
# Change this for any non-local deployment; never commit a real key.
MEILI_MASTER_KEY=dev-key

# Meilisearch Server
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700

# API Configuration
# Set this for production deployments
# MEILISEARCH_API_KEY=your-secure-key-here

# Indexing Configuration
MEILISEARCH_BATCH_SIZE=1000
MEILISEARCH_ENABLED=true

# Sphinx Configuration (optional)
# Enable auto-indexing on Sphinx builds
SPHINX_MEILISEARCH_AUTO_INDEX=true

# Logging
# DEBUG, INFO, WARNING, ERROR
LOGLEVEL=INFO

# Development
MEILISEARCH_DEV_MODE=true
